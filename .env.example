# ── Khoj Mitra  .env.example ──────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Django secret key (generate one at https://djecrety.ir/)
SECRET_KEY=your-secret-key-here

# Set to True only on your local machine, False on production
DEBUG=True

# Your MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/khoj_mitra?retryWrites=true&w=majority

# The database name inside MongoDB Atlas
MONGO_DB_NAME=khoj_mitra

# Only emails ending with this domain can register
# Example: student.university.edu
ALLOWED_EMAIL_DOMAIN=college.edu

# Comma-separated list of allowed hosts (for production)
ALLOWED_HOSTS=localhost,127.0.0.1
